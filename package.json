{
  "name": "revdesk-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Official TypeScript SDKs for RevDesk.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cell-labs-inc/revdesk-sdk"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "type-check": "bun run --filter '*' type-check",
    "gen:types": "bun run --filter '@revdesk/sdk' gen:types",
    "validate:discovery": "node scripts/validate-discovery.mjs"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=18"
  }
}
