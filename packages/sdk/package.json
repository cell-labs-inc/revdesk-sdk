{
  "name": "@revdesk/sdk",
  "version": "0.2.0",
  "description": "Official typed TypeScript client for the RevDesk v1 API.",
  "license": "MIT",
  "homepage": "https://docs.revdesk.com/api-reference/sdks",
  "repository": {
    "type": "git",
    "url": "https://github.com/cell-labs-inc/revdesk-sdk",
    "directory": "packages/sdk"
  },
  "keywords": [
    "revdesk",
    "voice",
    "sms",
    "phone-numbers",
    "api",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist .turbo",
    "gen:types": "bash ./scripts/gen-openapi-types.sh",
    "type-check": "bash ./scripts/type-check.sh"
  },
  "devDependencies": {
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
