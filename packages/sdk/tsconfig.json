{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // TS6 bridge: tsup's dts build injects `baseUrl` into its compiler options,
    // which TS6 rejects as deprecated (TS5101). Remove once tsup stops injecting
    // it (tracked with the TS 7 upgrade, DEV-520).
    "ignoreDeprecations": "6.0",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": false,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true,
    "allowJs": true,
    "lib": ["es2022", "dom"],
    "target": "es2022",
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
